{
	"compilerOptions": {
		"target": "ES2022",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"skipLibCheck": true,
		"outDir": "./dist",

		/* Bundler mode */
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force",
		"noEmit": true,

		/* Linting */
		"strict": true,
		"noUnusedLocals": false,
		"noUnusedParameters": false,
		"erasableSyntaxOnly": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedSideEffectImports": true,

		/* Browser dev tools */
		"sourceMap": true,
		"inlineSources": true,

		/* baseUrl = "." for a relative root on static host */
		/* this means the contents of /dist can be put onto: */
		/* https://yourdomain.org/design/generator/ */
		/* and it will load URLs starting with "/..." from this path */
		"baseUrl": "."
		// "paths": {
		// 	"utils/*": ["src/lib/utils/*"]
		// }
	},
	"include": ["src/**/*"]
}
